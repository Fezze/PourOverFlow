{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Verify: vitest",
      "type": "shell",
      "command": "node",
      "args": [
        "node_modules/vitest/vitest.mjs",
        "run",
        "--config",
        "test/vitest.config.ts"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Verify: Vitest unit coverage",
      "type": "shell",
      "command": "node",
      "args": [
        "node_modules/vitest/vitest.mjs",
        "run",
        "--config",
        "test/vitest.config.ts",
        "--coverage",
        "--mode",
        "unit"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Verify: Vitest integration coverage",
      "type": "shell",
      "command": "node",
      "args": [
        "node_modules/vitest/vitest.mjs",
        "run",
        "--config",
        "test/vitest.config.ts",
        "--coverage",
        "--mode",
        "integration"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Verify: Playwright harness smoke",
      "type": "shell",
      "command": "node",
      "args": [
        "scripts/playwright-simulator-coverage.mjs",
