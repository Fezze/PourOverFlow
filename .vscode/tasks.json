      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Verify: Playwright harness coverage",
      "type": "shell",
      "command": "node",
      "args": [
        "scripts/playwright-simulator-coverage.mjs",
        "--module-harness",
        "--coverage"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Verify: visual preview",
      "type": "shell",
      "command": "node",
      "args": [
        "scripts/watch-preview.mjs",
        "--verify"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Verify: Playwright phone flows",
      "type": "shell",
      "command": "node",
      "args": [
        "scripts/phone-preview.mjs",
        "--verify-flow"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Verify: Playwright phone coverage",
      "type": "shell",
      "command": "node",
      "args": [
        "scripts/phone-preview.mjs",
        "--coverage"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Verify: Zeus build",
      "type": "shell",
      "command": "node",
      "args": [
        "scripts/run-zeus-command.mjs",
        "build",
        "--no-version-bump"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Verify: all tests and coverage",
      "dependsOrder": "sequence",
      "dependsOn": [
        "Verify: Vitest unit coverage",
        "Verify: Vitest integration coverage",
        "Verify: Playwright harness coverage",
        "Verify: Playwright phone coverage",
        "Verify: visual preview",
        "Verify: Zeus build"
