{
  "name": "pouroverflow",
  "version": "0.5.1",
  "private": true,
  "type": "module",
  "description": "PourOverFlow Zepp OS scaffold",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11 <12"
  },
  "scripts": {
    "hooks:install": "git config --local core.hooksPath .githooks",
    "version:bump:patch": "node scripts/version-proxy.mjs patch",
    "version:bump:minor": "node scripts/version-proxy.mjs minor",
    "version:bump:major": "node scripts/version-proxy.mjs major",
    "build": "node scripts/run-zeus-command.mjs build",
    "build:raw": "node scripts/run-zeus-command.mjs build --no-version-bump",
    "dev": "node scripts/run-zeus-command.mjs dev",
    "zepp:dev": "node scripts/run-zeus-command.mjs dev",
    "preview": "node scripts/run-zeus-command.mjs preview",
    "bridge": "node scripts/run-zeus-command.mjs bridge",
    "push": "node scripts/git-push-proxy.mjs",
    "doctor:ubuntu": "node scripts/doctor-ubuntu.mjs",
    "test": "node node_modules/vitest/vitest.mjs run --config test/vitest.config.ts",
    "test:coverage": "npm run test:coverage:unit && npm run test:coverage:integration",
    "test:coverage:unit": "node node_modules/vitest/vitest.mjs run --config test/vitest.config.ts --mode unit --coverage",
    "test:coverage:integration": "node node_modules/vitest/vitest.mjs run --config test/vitest.config.ts --mode integration --coverage",
    "test:coverage:combined": "node node_modules/vitest/vitest.mjs run --config test/vitest.config.ts --coverage",
    "test:coverage:all": "npm run test:coverage && npm run test:playwright:coverage:harness && npm run test:playwright:coverage:phone",
    "test:playwright": "node scripts/playwright-simulator-coverage.mjs",
    "test:playwright:screens": "node scripts/watch-preview.mjs --verify",
    "test:playwright:harness": "node scripts/playwright-simulator-coverage.mjs --module-harness",
    "test:playwright:coverage:harness": "node scripts/playwright-simulator-coverage.mjs --module-harness --coverage",
    "test:playwright:phone": "node scripts/phone-preview.mjs --verify-flow",
    "test:playwright:coverage:phone": "node scripts/phone-preview.mjs --coverage",
    "verify:visual": "node scripts/watch-preview.mjs --verify",
    "preview:watch": "node scripts/watch-preview.mjs",
    "preview:phone": "node scripts/phone-preview.mjs",
    "validation:logs": "node scripts/validation-log-report.mjs",
    "sim:doctor": "node scripts/simulator-doctor.mjs",
    "sim:smoke": "node scripts/playwright-simulator-coverage.mjs",
    "verify": "npm run test:coverage:all && npm run verify:visual && npm run build:raw",
    "verify:fast": "npm test && npm run build:raw"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.1",
    "@zeppos/zeus-cli": "^1.9.0",
    "esbuild": "^0.27.7",
    "istanbul-lib-coverage": "^3.2.2",
    "istanbul-lib-report": "^3.0.1",
    "istanbul-reports": "^3.2.0",
    "playwright-core": "^1.58.2",
    "v8-to-istanbul": "^9.3.0",
    "vitest": "^4.1.1"
  }
}
